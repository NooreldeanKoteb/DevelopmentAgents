name: Autonomous AI Development System
description: |
  A collaborative AI agent system that autonomously researches, designs, 
  develops, tests, and maintains software projects. Integrates with OpenAI 
  for enhanced capabilities and requires minimal human intervention.

# Core Configuration
base_config:
  language: python
  python_version: "3.11"
  package_manager: poetry
  async: true
  linting:
    tools:
      - ruff
      - mypy
      - black
    max_line_length: 100
    strict_typing: true
  documentation: sphinx
  test_framework: pytest

# Project Structure
project_structure:
  - agents/
    - __init__.py
    - base/
      - __init__.py
      - base_agent.py          # Base agent functionality
      - memory.py             # Memory management system
      - message.py            # Message handling system
      - errors.py            # Custom exceptions
      - context.py           # Context management
    - project_manager/
      - __init__.py
      - agent.py             # Project management implementation
      - planner.py           # Project planning logic
      - task_manager.py      # Task management
      - resource_manager.py  # Resource allocation
    - knowledge/
      - __init__.py
      - agent.py             # Knowledge management
      - openai_client.py     # OpenAI API integration
      - vector_store.py      # Vector database handling
      - embeddings.py        # Text embedding logic
      - search.py           # Search functionality
    - coding/
      - __init__.py
      - agent.py             # Code generation agent
      - generator.py         # Code generation logic
      - reviewer.py         # Code review system
      - analyzer.py         # Code analysis
      - refactor.py         # Code refactoring
    - testing/
      - __init__.py
      - agent.py             # Test management
      - generator.py         # Test generation
      - runner.py           # Test execution
      - reporter.py         # Test reporting
    - environment/
      - __init__.py
      - agent.py             # Environment setup
      - setup.py            # Environment configuration
      - dependency.py       # Dependency management
      - container.py        # Container management
    - security/
      - __init__.py
      - agent.py             # Security management
      - scanner.py          # Security scanning
      - validator.py        # Security validation
      - auditor.py         # Security auditing
    - documentation/
      - __init__.py
      - agent.py             # Documentation management
      - generator.py         # Doc generation
      - validator.py        # Doc validation
  - core/
    - __init__.py
    - config/
      - __init__.py
      - settings.py
      - constants.py
    - messaging/
      - __init__.py
      - broker.py
      - queue.py
    - storage/
      - __init__.py
      - vector_db.py
      - message_store.py
    - monitoring/
      - __init__.py
      - metrics.py
      - logger.py
    - utils/
      - __init__.py
      - async_utils.py
      - security.py
  - prompts/
    - code/
      - generation.yaml
      - review.yaml
      - refactor.yaml
    - search/
      - technical.yaml
      - solution.yaml
    - analysis/
      - architecture.yaml
      - performance.yaml
    - testing/
      - test_generation.yaml
      - test_analysis.yaml
  - tests/
    - unit/
    - integration/
    - e2e/
  - docs/
    - architecture/
    - api/
    - guides/

# Dependencies
dependencies:
  required:
    - langchain==0.1.0
    - openai==1.3.0
    - pydantic==2.5.0
    - asyncio==3.4.3
    - aiohttp==3.9.0
    - redis==5.0.1
    - chromadb==0.4.0
    - pytest-asyncio==0.23.0
    - black==23.11.0
    - ruff==0.1.6
    - mypy==1.7.0
    - sphinx==7.2.0
    - prometheus-client==0.19.0
  development:
    - pytest-cov
    - pytest-asyncio
    - black
    - isort
    - mypy
    - pre-commit

# Agent Definitions
agent_rules:
  base_agent:
    required_methods:
      - process_message
      - execute_task
      - handle_error
    memory_management: required
    error_handling: required
    logging: required
    
  project_manager:
    responsibilities:
      - project_planning
      - task_distribution
      - resource_allocation
      - progress_monitoring
    
  knowledge_agent:
    responsibilities:
      - information_gathering
      - knowledge_storage
      - context_management
      - research_synthesis
    integrations:
      - openai_api
      - vector_store
      
  coding_agent:
    responsibilities:
      - code_generation
      - code_review
      - refactoring
      - optimization
    tools:
      - static_analysis
      - formatters
      - linters
      
  environment_agent:
    responsibilities:
      - environment_setup
      - dependency_management
      - tool_configuration
      - container_management
      
  testing_agent:
    responsibilities:
      - test_generation
      - test_execution
      - coverage_analysis
      - performance_testing
      
  security_agent:
    responsibilities:
      - security_analysis
      - vulnerability_scanning
      - dependency_auditing
      - compliance_checking
      
  documentation_agent:
    responsibilities:
      - code_documentation
      - api_documentation
      - guide_generation
      - architecture_documentation

# Performance Rules
performance_rules:
  caching:
    strategy: tiered
    layers:
      memory:
        size: 1GB
        ttl: 1h
      redis:
        size: 10GB
        ttl: 24h
      disk:
        size: 100GB
        ttl: 7d
  
  rate_limiting:
    openai_api:
      max_requests: 50
      per_timeframe: 1m
    agent_communication:
      max_messages: 1000
      per_timeframe: 1s

# Memory Management
memory_rules:
  types:
    - working_memory
    - long_term_memory
    - context_memory
  storage:
    working_memory: redis
    long_term_memory: vector_db
  cleanup:
    short_term_ttl: 1h
    working_memory_ttl: 24h

# Communication Rules
communication_rules:
  protocol: async
  message_format: json
  required_fields:
    - sender
    - recipient
    - message_type
    - payload
    - timestamp
  retry:
    max_attempts: 3
    backoff: exponential

# Security Rules
security_rules:
  required_checks:
    - dependency_scan
    - static_analysis
    - security_testing
  forbidden_patterns:
    - "os.system"
    - "eval"
    - "exec"
    - "subprocess.call"
  required_headers:
    - security_review
    - approved_by

# Testing Rules
test_rules:
  patterns:
    - "test_*.py"
    - "*_test.py"
  required_coverage: 85
  async_testing: true
  fixtures:
    - mock_message_broker
    - mock_vector_store
    - mock_llm

# Documentation Rules
documentation_rules:
  style: google
  required_sections:
    - Args
    - Returns
    - Raises
    - Examples
    - Async Notes
  api_docs: true
  architecture_docs: true

# Monitoring Rules
monitoring_rules:
  metrics:
    - agent_message_count
    - task_completion_time
    - memory_usage
    - error_rate
    - llm_latency
  logging:
    level: INFO
    format: json
    required_fields:
      - timestamp
      - agent_id
      - action
      - status

# Version Control Rules
version_control:
  branch_naming: "{type}/{description}"
  commit_message: "{type}: {description}"
  required_reviews: 1
  protected_branches:
    - main
    - development

# Error Handling
error_rules:
  required_handling:
    - message_processing_errors
    - task_execution_errors
    - communication_errors
  error_reporting:
    level: ERROR
    include_context: true
    notify_supervisor: true

# Development Rules
development_rules:
  hot_reload: enabled
  debug_mode: conditional
  profiling: enabled
  optimization_warnings: true
  code_style:
    line_length: 88
    quotes: double
    docstring: google

Development Guidelines:
  1. All agents must communicate via structured JSON
  2. Use OpenAI for intelligent decision making
  3. Implement proper error handling
  4. Add comprehensive logging
  5. Include performance monitoring
  6. Follow async patterns
  7. Maintain proper documentation
  8. Keep the code clean and readable
